# Optional: only needed for CLI / GitHub Actions deploys.
# Prefer connecting this repo to the existing Vercel project in the dashboard.
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# Production must have at least one durable store (Notion, Resend, or notify email).
# Local/dev also writes .data/sideshot-waitlist.json.

WAITLIST_NOTIFY_EMAIL=josephlamartaylor@icloud.com

# Notion internal integration with access to SIDESHOT Waitlist
# https://app.notion.com/p/2c3dc9f4c4454e3ebd1248d8aaed2818
NOTION_TOKEN=
NOTION_WAITLIST_DATABASE_ID=2c3dc9f4c4454e3ebd1248d8aaed2818

# Optional Resend notification (used instead of FormSubmit when set)
RESEND_API_KEY=
RESEND_FROM=SIDESHOT <onboarding@resend.dev>

# Set to 1 to keep the local JSON store in production (not recommended)
ALLOW_LOCAL_WAITLIST=

# Optional: swap SafeShot CTA to Stripe once unit economics are locked (SMI-147).
# Never invent an MSRP or ship date. Leave unset until checkout is real.
# SAFESHOT_PREORDER_URL=
