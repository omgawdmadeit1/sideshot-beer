# Required on the existing Vercel project for live waitlist writes.
# Do not commit real tokens. Do not create a second Vercel project.
# NOTION_TOKEN=
# Optional override. Default is the SIDESHOT Waitlist database.
# NOTION_WAITLIST_DATABASE_ID=2c3dc9f4c4454e3ebd1248d8aaed2818
#
# Optional: swap SafeShot CTA to Stripe once unit economics are locked (SMI-147).
# SAFESHOT_PREORDER_URL=
#
# Local only. Never set on Vercel production.
# WAITLIST_DEV_STORE=1
#
# Optional CLI / GitHub Actions deploys. Prefer Vercel Git integration.
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
